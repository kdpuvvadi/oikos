{
  "name": "oikos",
  "version": "0.6.0",
  "description": "Oikos, a PocketBase-backed expenses management app.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/sync-manifest-version.mjs",
    "dev": "vite",
