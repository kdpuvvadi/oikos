meta {
  name: Unauthenticated transactions forbidden
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/collections/oikos_transactions/records?perPage=1
  body: none
  auth: none
}

tests {
  test("guest cannot read transactions", function() {
    const status = res.getStatus();
    const body = res.getBody() || {};
    const items = body.items || [];
    // PocketBase may return 403/401, or 200 with an empty list for guests.
    if (status === 200) {
      expect(items.length).to.equal(0);
    } else {
      expect([400, 401, 403, 404]).to.include(status);
    }
  });
}
