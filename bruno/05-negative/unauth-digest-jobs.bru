meta {
  name: Unauthenticated digest jobs forbidden
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/collections/oikos_digest_jobs/records?perPage=1
  body: none
  auth: none
}

tests {
  test("guest cannot list digest jobs", function() {
    const status = res.getStatus();
    const body = res.getBody() || {};
    const items = body.items || [];
    if (status === 200) {
      expect(items.length).to.equal(0);
    } else {
      expect([400, 401, 403, 404]).to.include(status);
    }
  });
}
