meta {
  name: Create category
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/collections/oikos_categories/records
  body: json
  auth: none
}

headers {
  Authorization: {{adminToken}}
  Content-Type: application/json
}

script:pre-request {
  bru.setVar("brunoCategoryName", "Bruno Cat " + Date.now());
}

body:json {
  {
    "name": "{{brunoCategoryName}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("adminCategoryId", res.getBody().id || "");
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
}
