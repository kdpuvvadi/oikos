meta {
  name: Create store
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/collections/oikos_stores/records
  body: json
  auth: none
}

headers {
  Authorization: {{adminToken}}
  Content-Type: application/json
}

script:pre-request {
  bru.setVar("brunoStoreName", "Bruno Store " + Date.now());
}

body:json {
  {
    "name": "{{brunoStoreName}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("adminStoreId", res.getBody().id || "");
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
}
