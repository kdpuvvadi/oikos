meta {
  name: Update user digest preference
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/collections/users/records/{{otherUserId}}
  body: json
  auth: none
}

headers {
  Authorization: {{adminToken}}
  Content-Type: application/json
}

body:json {
  {
    "weeklyDigestOptOut": false
  }
}

assert {
  res.status: eq 200
  res.body.id: eq {{otherUserId}}
  res.body.weeklyDigestOptOut: eq false
}
