meta {
  name: Create payment method
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/collections/oikos_payment_methods/records
  body: json
  auth: none
}

headers {
  Authorization: {{adminToken}}
  Content-Type: application/json
}

script:pre-request {
  bru.setVar("brunoPmName", "Bruno PM " + Date.now());
}

body:json {
  {
    "name": "{{brunoPmName}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("adminPaymentMethodId", res.getBody().id || "");
  }
}

assert {
  res.status: eq 200
  res.body.id: isString
}
