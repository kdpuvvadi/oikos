meta {
  name: Update category
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/collections/oikos_categories/records/{{adminCategoryId}}
  body: json
  auth: none
}

headers {
  Authorization: {{adminToken}}
  Content-Type: application/json
}

script:pre-request {
  bru.setVar("brunoCategoryNameUpdated", "Bruno Cat Updated " + Date.now());
}

body:json {
  {
    "name": "{{brunoCategoryNameUpdated}}"
  }
}

assert {
  res.status: eq 200
  res.body.id: eq {{adminCategoryId}}
}
