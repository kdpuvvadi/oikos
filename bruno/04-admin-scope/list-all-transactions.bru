meta {
  name: List all transactions
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/collections/oikos_transactions/records?perPage=20&sort=-date&expand=user,category
  body: none
  auth: none
}

headers {
  Authorization: {{adminToken}}
}

assert {
  res.status: eq 200
  res.body.items: isArray
}
